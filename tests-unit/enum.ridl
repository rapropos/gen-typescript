webrpc = v1

name = enum-unit-tests
version = v1.0.0
basepath = /rpc

# Numeric-backed enum: generated members use the field name as the value.
enum Kind: uint32
  - USER
  - ADMIN

# String-backed enum: generated members use the field value.
enum Intent: string
  - openSession
  - closeSession

struct UserRec
  - kind: Kind
  - intent: Intent

service EnumTestService
  - GetKind() => (kind: Kind)

error 1000 Unauthorized "Unauthorized access" HTTP 401
error 1001 RateLimited  "Rate-limited"        HTTP 429
